# Copy this file to .env and add your own Gemini API key.
GOOGLE_API_KEY=your_gemini_api_key_here

# Choose models available to your Gemini API project.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Local persistent index folder (Docker Compose mounts ./data by default).
RAG_INDEX_DIR=data/indexes
